{
    "name": "owmods-gui-frontend",
    "private": true,
    "version": "0.15.7",
    "type": "module",
    "engines": {
        "npm": ">=10.0.0",
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "vite",
        "gen-types": "typeshare ../.. --lang=typescript --output-file=src/types.d.ts && prettier --write src/types.d.ts",
        "build": "tsc && vite build --emptyOutDir",
        "preview": "vite preview",
        "lint": "tsc --noEmit && eslint --cache . --fix",
        "lint-dry": "tsc --noEmit && eslint .",
        "prettify": "prettier --write . --ignore-unknown",
        "prettier-check": "prettier --check . --ignore-unknown"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/lab": "^9.0.0-beta.9",
        "@mui/material": "^9.4.0",
        "@tauri-apps/api": "^2.12.1",
        "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
        "@tauri-apps/plugin-dialog": "^2.8.1",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-shell": "^2.4.0",
        "@tauri-apps/plugin-window-state": "^2.5.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-virtuoso": "^4.18.16"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tauri-apps/cli": "^2.12.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vite-imagetools": "^12.0.1",
        "yaml": "^2.9.1"
    }
}
